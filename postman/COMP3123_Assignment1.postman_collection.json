                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "  pm.test(\"B blocked from reading A's employee\", () => {",
                      "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                      "  });"
                    ]
